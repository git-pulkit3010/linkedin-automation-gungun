# linkedin-publisher configuration
#
# Copy this file to .env and fill in the values. Put .env in ONE of these places
# (the first file found wins, in this order):
#
#   1. the path given to --env-file
#   2. the path in the LINKEDIN_PUBLISHER_ENV_FILE environment variable
#   3. linkedin-publisher/.env                     (inside this skill folder)
#   4. <your workspace>/.env                       (next to the skill folder)
#   5. <your workspace parent>/.env
#
# Check the setup without posting anything:
#   python3 scripts/doctor.py

# --- Required ---
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# --- Optional ---
# Pin one connected account when several ACTIVE LinkedIn accounts exist for the user:
# COMPOSIO_CONNECTED_ACCOUNT_ID=
# Pin one Google Drive connection when several are ACTIVE for the same user:
# GOOGLEDRIVE_CONNECTED_ACCOUNT_ID=
# Set the author manually if the automatic profile lookup fails:
# LINKEDIN_AUTHOR_URN=urn:li:person:your-member-id
# Only needed by the one-time account connection script, not by this skill:
# LINKEDIN_AUTH_CONFIG_ID=
# Only needed by the optional one-time Google Drive connection helper:
# GOOGLEDRIVE_AUTH_CONFIG_ID=
